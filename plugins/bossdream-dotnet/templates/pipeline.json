{
  "stages": [
    { "id": "build", "order": 1, "cmd": "dotnet build -warnaserror", "tier": "local", "blocking": "hard" },
    { "id": "format", "order": 2, "cmd": "dotnet format --verify-no-changes", "tier": "local", "blocking": "hard" },
    { "id": "theme-check", "order": 3, "internal": "style-check", "tier": "local", "blocking": "hard", "requiresStyle": true },
    { "id": "gherkin", "order": 4, "internal": "gherkin-check", "tier": "local", "blocking": "hard" },
    { "id": "arch", "order": 5, "cmd": "dotnet test tests/Arch", "tier": "local", "blocking": "hard", "enabled": false },
    { "id": "unit", "order": 6, "cmd": "dotnet test ${testProject} /p:CollectCoverage=true /p:Threshold=80", "tier": "local", "blocking": "hard", "requiresTesting": true },
    { "id": "integration", "order": 7, "cmd": "dotnet test tests/Integration", "tier": "ci", "blocking": "hard", "enabled": false },
    { "id": "bdd", "order": 8, "cmd": "dotnet test ${testProject} --filter Category=bdd", "tier": "ci", "blocking": "hard", "requiresBdd": true },
    { "id": "e2e", "order": 9, "cmd": "dotnet test tests/E2E", "tier": "ci", "blocking": "hard", "enabled": false },
    { "id": "mutation", "order": 10, "cmd": "dotnet stryker", "tier": "local", "blocking": "hard", "requiresTesting": true },
    { "id": "docdrift", "order": 11, "internal": "docdrift-check", "tier": "ci", "blocking": "soft", "enabled": false }
  ]
}
